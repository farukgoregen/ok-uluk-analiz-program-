<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Okçuluk Analiz</title>
    <meta name="description" content="Okçuluk atış videosu analizi — dirsek açıları ve atış benzerliği" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M9 4c8 5 8 19 0 24' fill='none' stroke='%232F4A38' stroke-width='2.5' stroke-linecap='round'/%3E%3Cpath d='M9 4v24' stroke='%23B8892F' stroke-width='1.5'/%3E%3Cpath d='M6 16h22m-4-3 4 3-4 3' fill='none' stroke='%238A6A45' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css?v=12" />
</head>
<body>
    <a class="skip-link" href="#main">İçeriğe geç</a>

    <header class="app-header">
        <div class="container header-inner">
            <a href="/" class="brand" aria-label="Okçuluk Analiz ana sayfa">
                <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
                    <path d="M9 4c8 5 8 19 0 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                    <path d="M9 4v24" stroke="var(--brass)" stroke-width="1.3" />
                    <path d="M6 16h21m-4-3 4 3-4 3" fill="none" stroke="var(--leather)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="brand-name">Okçuluk Analiz</span>
            </a>
            <nav class="header-actions" aria-label="Ana gezinme">
                <a href="#historySection" id="navHistory" class="btn btn-ghost" aria-label="Geçmiş analizler">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
                    <span class="hide-mobile">Geçmiş Analizler</span>
                </a>
                <button type="button" id="navNewAnalysis" class="btn btn-primary btn-sm">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                    <span>Yeni Analiz</span>
                </button>
            </nav>
        </div>
    </header>

    <main id="main" class="container main-content">
        @RenderBody()
    </main>

    <footer class="app-footer">
        <div class="container">
            <p>Okçuluk Analiz &middot; Atış tutarlılığı için poz analizi &middot; &copy; @DateTime.Now.Year</p>
        </div>
    </footer>

    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
